# =============================================================================
# Agendia — environment variables template
# Copy this file to .env (already gitignored) and fill in real values.
# docker-compose reads it through the `env_file` directive.
# =============================================================================

# ----- Shared ---------------------------------------------------------------
NODE_ENV=development

# ----- API (NestJS) ---------------------------------------------------------
API_PORT=3001

# PostgreSQL connection string consumed by Drizzle / node-postgres.
# When running via docker-compose, host resolves to the `postgres` service.
DATABASE_URL=postgres://agendia:agendia@postgres:5432/agendia

# Redis connection string used by cache-manager and rate limiter.
REDIS_URL=redis://redis:6379

# JWT — generate with `openssl rand -hex 32` for real environments.
JWT_ACCESS_SECRET=replace-with-32-byte-random-hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-hex
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor. 12 is a reasonable trade-off for dev/prod.
BCRYPT_SALT_ROUNDS=12

# Cache TTL in seconds for the exams listing (Redis-backed).
EXAMS_CACHE_TTL_SECONDS=300

# ----- PostgreSQL service (docker-compose only) -----------------------------
POSTGRES_USER=agendia
POSTGRES_PASSWORD=agendia
POSTGRES_DB=agendia

# ----- Web (Next.js) --------------------------------------------------------
WEB_PORT=3000

# Public URL the browser uses to reach the API. Must be reachable from the
# host machine, not from inside the docker network, so it points to localhost.
NEXT_PUBLIC_API_URL=http://localhost:3001
